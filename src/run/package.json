{
  "name": "@tapjs/run",
  "version": "4.5.10",
  "description": "Command-line interface for the node-tap runner",
  "tshy": {
    "dialects": [
      "esm"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    },
    "selfLink": false
  },
  "type": "module",
  "bin": {
    "tap-run": "dist/esm/index.js"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tshy",
    "postprepare": "rm -rf XXX",
    "pretest": "npm run prepare",
    "presnap": "npm run prepare",
    "test": "tap",
    "snap": "tap",
    "format": "prettier --write . --log-level warn --ignore-path ../../.prettierignore --cache",
    "typedoc": "typedoc --tsconfig tsconfig/esm.json ./src/*.ts"
  },
  "author": "Isaac Z. Schlueter <i@izs.me> (https://blog.izs.me)",
  "license": "BlueOak-1.0.0",
  "dependencies": {
    "@isaacs/which": "^7.0.4",
    "@tapjs/after": "3.3.12",
    "@tapjs/before": "4.3.12",
    "@tapjs/config": "5.6.6",
    "@tapjs/processinfo": "^3.1.12",
    "@tapjs/reporter": "4.5.0",
    "@tapjs/spawn": "4.3.12",
    "@tapjs/stdin": "4.3.12",
    "@tapjs/test": "4.4.10",
    "c8": "^12.0.0",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.2",
    "foreground-child": "^4.0.0",
    "glob": "^13.0.2",
    "minipass": "^7.0.4",
    "mkdirp": "^3.0.1",
    "node-options-to-argv": "^1.0.0",
    "opener": "^1.5.2",
    "pacote": "^21.0.4",
    "path-scurry": "^2.0.0",
    "resolve-import": "^2.4.0",
    "rimraf": "^6.0.0",
    "semver": "^7.7.2",
    "signal-exit": "^4.1.0",
    "tap-parser": "18.3.4",
    "tap-yaml": "4.4.2",
    "tcompare": "9.3.2",
    "trivial-deferred": "^2.0.0"
  },
  "peerDependencies": {
    "@tapjs/core": "4.6.0"
  },
  "tap": {
    "typecheck": false,
    "coverage-map": "map.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tapjs/tapjs.git",
    "path": "src/run"
  },
  "homepage": "https://github.com/tapjs/tapjs/tree/main/src/run#readme",
  "bugs": {
    "url": "https://github.com/tapjs/tapjs/issues"
  },
  "keywords": [
    "tapjs",
    "runner",
    "cli"
  ],
  "funding": {
    "url": "https://github.com/sponsors/isaacs"
  },
  "engines": {
    "node": "20 || >=22"
  }
}
